PORT=3010

# Claude Remote MCP OAuth login password (minimum 24 characters)
MCP_CONNECTOR_SECRET=replace-with-a-long-random-secret
MCP_ALLOWED_REDIRECT_URIS=https://claude.ai/api/mcp/auth_callback

# Instagram Professional account / Meta Graph API
META_IG_USER_ID=
META_ACCESS_TOKEN=
META_API_VERSION=v25.0
META_GRAPH_BASE_URL=https://graph.facebook.com

# Public media storage used by instagram_upload_media
BLOB_READ_WRITE_TOKEN=
INSTAGRAM_MAX_MEDIA_MB=100
INSTAGRAM_VIDEO_PROCESSING_TIMEOUT_MS=600000

# Durable Instagram scheduling (Upstash QStash)
QSTASH_URL=https://qstash.upstash.io
QSTASH_TOKEN=
QSTASH_MAX_SCHEDULE_DAYS=7
# Optional; MCP_CONNECTOR_SECRET is used when this is empty.
INSTAGRAM_SCHEDULER_SECRET=

# Existing optional search tools
ETSY_API_KEY=
ALIBABA_API_KEY=

# Amazon UAE profitability (SP-API Europe endpoint, marketplace A2VIGQ35RCS4UG)
# Use AE-specific values when available; EU/common values are accepted as fallbacks.
AMAZON_LWA_CLIENT_ID_AE=
AMAZON_LWA_CLIENT_SECRET_AE=
AMAZON_LWA_REFRESH_TOKEN_AE=
AMAZON_SELLER_ID_AE=

# Optional Amazon Ads Reporting v3 for Sponsored Products spend
AMAZON_ADS_CLIENT_ID=
AMAZON_ADS_PROFILE_ID_AE=
